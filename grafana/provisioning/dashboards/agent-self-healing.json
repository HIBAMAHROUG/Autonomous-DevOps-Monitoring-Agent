{
  "title": "Agent Self-Healing",
  "uid": "agent-self-healing",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Taux d'auto-rÃ©solution",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "agent_self_healing_success_ratio", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "DÃ©cisions par mode",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum by (mode) (agent_decisions_total)", "legendFormat": "{{mode}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Incidents par issue",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum by (outcome) (agent_incidents_total)", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Approbations en attente",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "agent_pending_approvals", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "MTTR (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(agent_mttr_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(agent_mttr_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Actions de remÃ©diation (succÃ¨s/Ã©chec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum by (action_type, result) (rate(agent_remediation_actions_total[5m]))", "legendFormat": "{{action_type}} ({{result}})", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Confiance des dÃ©cisions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(agent_decision_confidence_bucket[5m])) by (le))", "legendFormat": "confiance mÃ©diane", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Garde-fous sÃ©curitÃ©",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "agent_safety_circuit_breaker_open", "legendFormat": "Circuit breaker ouvert", "refId": "A" },
        { "expr": "agent_safety_kill_switch_enabled", "legendFormat": "Kill switch actif", "refId": "B" }
      ]
    }
  ]
}

